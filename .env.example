# npm run setup fills blank passwords with independent random values.
RABBITMQ_VHOST=restaurant
RABBITMQ_ADMIN_USER=restaurant_admin
RABBITMQ_ADMIN_PASSWORD=
RABBITMQ_BOOKING_USER=booking
RABBITMQ_BOOKING_PASSWORD=
RABBITMQ_OPERATIONS_USER=operations
RABBITMQ_OPERATIONS_PASSWORD=
RABBITMQ_TRACKING_USER=tracking
RABBITMQ_TRACKING_PASSWORD=
RABBITMQ_NOTIFICATION_USER=notification
RABBITMQ_NOTIFICATION_PASSWORD=
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_NETWORK=restaurant-backend
